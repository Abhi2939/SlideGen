# Required for live deck generation. Keep real credentials in your private environment.
GROQ_API_KEY=
SLIDEGEN_TRUST_CLOUDFLARE_IP_HEADER=false

# Job storage and execution limits
SLIDEGEN_DATA_DIR=./data
SLIDEGEN_MAX_JOBS=1
SLIDEGEN_MAX_ACTIVE_JOBS=20
SLIDEGEN_RETENTION_HOURS=24
SLIDEGEN_JOB_TIMEOUT_SECONDS=1800

# Provider and structured-output behavior
SLIDEGEN_LLM_PROVIDER=groq
SLIDEGEN_STRUCTURED_ATTEMPTS=2
SLIDEGEN_DESIGN_PIPELINE=editorial
SLIDEGEN_DELIVERY_MODE=draft
SLIDEGEN_VISION_MODEL=qwen/qwen3.8-27b
SLIDEGEN_USE_SYSTEM_PROXY=false

# Shared process-wide LLM admission and retries (Render must use one worker)
WEB_CONCURRENCY=1
LLM_TPM_LIMIT=8000
LLM_SAFETY_MARGIN=0.85
LLM_CONCURRENCY=1
LLM_MAX_RETRIES=8
LLM_WAIT_BUDGET_SECONDS=180
LLM_FALLBACK_AFTER_SECONDS=30
LLM_FALLBACK_MODELS=
# Optional completion caps; unset uses the stage's tightly sized request budget.
LLM_ANALYZE_MAX_TOKENS=
LLM_OUTLINE_MAX_TOKENS=
LLM_WRITE_MAX_TOKENS=
LLM_REPAIR_MAX_TOKENS=
LLM_REVIEW_MAX_TOKENS=

# Optional model overrides; defaults are documented in app/config.py.
SLIDEGEN_MODEL=
SLIDEGEN_ANALYSIS_MODEL=openai/gpt-oss-20b
SLIDEGEN_OUTLINE_MODEL=openai/gpt-oss-20b
SLIDEGEN_WRITING_MODEL=openai/gpt-oss-120b
SLIDEGEN_REVIEW_MODEL=openai/gpt-oss-20b

# Optional photo search; verified beauty/finance stock downloads work without a key.
SLIDEGEN_ASSETS_ENABLED=true
SLIDEGEN_CURATED_PHOTOS_ENABLED=true
SLIDEGEN_ASSET_CACHE_DIR=
PEXELS_API_KEY=
UNSPLASH_ACCESS_KEY=
